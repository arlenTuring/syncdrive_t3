# ── 相依套件 ─────────────────────────────
node_modules/

# ── 環境變數與機密（嚴禁提交）────────────
.env
.env.*
!.env.example

# ── 本機開發執行期產物（日誌、PID、除錯截圖，勿提交）──
.dev/
backend/logs/

# 地圖庫 API 發佈快取（由編輯器 PUT，模擬器 GET）
backend/data/published-maps/*.json

# shell 暫存（磁碟滿時可能殘留）
sh-thd-*

# ── 建置產物 ────────────────────────────
frontend/dist/
backend/dist/
coverage/
backend/coverage/

# ── 測試輸出 ────────────────────────────
frontend/test-results/

# ── 手工快照備份（改用 git 歷史）──────────
.backups/
.archive/

# ── Mosquitto 密碼檔（含雜湊密碼，勿提交）──
mosquitto/config/passwordfile

# ── 作業系統 / 編輯器 ────────────────────
.DS_Store
*.swp

# 部署：機器上的密鑰、部署狀態與同步目標都不進版控
deploy/.env
deploy/.state/
deploy/.target
deploy/seed/
deploy/images/
deploy/dist/
deploy/.htpasswd
deploy/.htpasswd-external
deploy/.htpasswd-web
deploy/.htpasswd-vendor
deploy/mqtt-credentials.txt
mosquitto/config/passwordfile

# 資料清理前的備份（含營運資料，不進版控）
.purge-backup/

# 同步到 GCP 前的地圖備份，本機留存不進版控
.map-backup/

# MQTT TLS 憑證：私鑰絕對不能進版控，公開的憑證也一起排除——
# 它們由 deploy/mqtt-certs.sh 在目標主機上產生，每個環境一套。
mosquitto/certs/
