# 前端與文件站的靜態映像
#
# 基底映像釘在 digest（見 deploy/images.lock）。
#
# 前端在映像裡 build，正式機不需要裝 Node 也不會受本機 node 版本影響。
FROM node:20-alpine@sha256:fb4cd12c85ee03686f6af5362a0b0d56d50c58a04632e6c0fb8363f609372293 AS builder
WORKDIR /app

COPY frontend/package*.json ./
RUN npm ci

COPY frontend/ ./
RUN npm run build

FROM nginx:1.27-alpine@sha256:65645c7bb6a0661892a8b03b89d0743208a18dd2f3f17a54ef4b76fb8e2f2a10 AS runner

# 前端 SPA
COPY --from=builder /app/dist /usr/share/nginx/html

# 內部技術文件站（完整）：只在 80 那一側提供
COPY document/ /usr/share/nginx/docs/

# 對外文件站：<strong>逐份列舉</strong>，不是複製整個資料夾再排除。
#
# document/ 裡有使用者對話紀錄、開發進度、測試項目、排班演算法全覽、資料表關聯
# ——那些都不該給協力廠商。用「排除法」遲早會漏：新增一份內部文件時沒有人會
# 想到要去補排除清單，而漏掉的後果是它直接出現在對外站上。列舉法的失敗方向
# 相反：忘了加就是廠商看不到，會被問，然後補上。
COPY document/協力廠商介接說明書.md /usr/share/nginx/public-docs/
COPY document/車輛即時ETA-API.md    /usr/share/nginx/public-docs/
COPY document/班表Timetable-API.md  /usr/share/nginx/public-docs/
# 六份通訊協議：那是與車端／中心端的契約，本來就要給對方看
# 路徑含空白必須用 JSON 陣列形式；shell 形式的引號 Docker 的 COPY 解析不吃
COPY ["document/MQTT 通訊架構與 Topic 命名規範.md", "/usr/share/nginx/public-docs/"]
COPY document/車輛動態協議.md              /usr/share/nginx/public-docs/
COPY document/營運任務狀態協議.md          /usr/share/nginx/public-docs/
COPY document/設備健康與異常告警協議.md    /usr/share/nginx/public-docs/
COPY document/動態控制與特殊事件協議.md    /usr/share/nginx/public-docs/
COPY document/月台門與車門協議.md          /usr/share/nginx/public-docs/
COPY deploy/portal/docs/ /usr/share/nginx/public-docs/

# 兩個入口頁
COPY deploy/portal/internal.html deploy/portal/external.html /usr/share/nginx/portal/

COPY deploy/nginx.conf /etc/nginx/conf.d/default.conf

EXPOSE 80
