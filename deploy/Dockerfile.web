# 前端與文件站的靜態映像
#
# 基底映像釘在 digest（見 deploy/images.lock）。
#
# 前端在映像裡 build，正式機不需要裝 Node 也不會受本機 node 版本影響。
FROM node:20-alpine@sha256:fb4cd12c85ee03686f6af5362a0b0d56d50c58a04632e6c0fb8363f609372293 AS builder
WORKDIR /app

COPY frontend/package*.json ./
RUN npm ci

COPY frontend/ ./
RUN npm run build

FROM nginx:1.27-alpine@sha256:65645c7bb6a0661892a8b03b89d0743208a18dd2f3f17a54ef4b76fb8e2f2a10 AS runner

# 前端 SPA
COPY --from=builder /app/dist /usr/share/nginx/html

# 技術文件站（Wiki）；與前端同一台 nginx，掛在 /docs
COPY document/ /usr/share/nginx/docs/

COPY deploy/nginx.conf /etc/nginx/conf.d/default.conf

EXPOSE 80
