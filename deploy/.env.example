# 複製本檔為 deploy/.env 後填入實際值；deploy/.env 不得提交進版控。
# bootstrap.sh 會在檔案不存在時自動由本檔產生，並隨機產生兩把密鑰。

# ── 資料庫 ───────────────────────────────────────────────────
# COMPOSE_PROFILES=bundled-db：資料庫跟服務跑在同一台（預設）。
# 要把資料庫獨立到另一台時：把這個變數清空，並把 DB_HOST 指向那台。
# compose 其餘部分不必改，也不需要第二份設定檔。
COMPOSE_PROFILES=bundled-db
DB_HOST=postgres
DB_USER=syncdrive_user
DB_PASSWORD=
DB_NAME=syncdrive_t3

# ── 對外介面金鑰 ─────────────────────────────────────────────
# 協力廠商呼叫對外 API 時要帶的 x-api-key。
# NODE_ENV=production 時<strong>未設定會直接拒絕請求</strong>（fail-safe），不會靜默放行。
VTMS_API_KEY=

# ── CORS ────────────────────────────────────────────────────
# 我方前端的來源。留 * 等於任何網站都能用瀏覽器打我們的 API，正式機不要留 *。
# 範例：http://10.140.0.5,https://vtms.example.com
CORS_ORIGIN=

# ── MQTT ────────────────────────────────────────────────────
# 車端連進來的埠要綁在哪個介面。預設 127.0.0.1＝只有本機，車輛連不進來。
# 真車或廠商要連時改成 0.0.0.0，並且務必先啟用 mosquitto.prod.conf 的帳密與 ACL，
# 再用防火牆限制來源網段——1883 目前是明文無認證，等於誰都能對車隊下指令。
MQTT_BIND=127.0.0.1

# ── 其他 ────────────────────────────────────────────────────
LOG_LEVEL=warn

# 設 1 時連 PMS 示範車的遙測也寫入時序庫。
# 正式車隊代號就是 PMS-01~11，所以要留軌跡回放與通訊中斷稽核就必須設 1；
# 一設磁碟就會以每天約 1 GB 的速度成長（11 台 × 1 Hz，保留 7 天）。
TELEMETRY_PERSIST_ALL=0

# 映像標籤；deploy.sh 會帶入 git 短雜湊，回滾時指定舊標籤即可
IMAGE_TAG=latest
