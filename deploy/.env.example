# 複製本檔為 deploy/.env 後填入實際值；deploy/.env 不得提交進版控。
# bootstrap.sh 會在檔案不存在時自動由本檔產生，並隨機產生兩把密鑰。

# ── 資料庫 ───────────────────────────────────────────────────
# # 加上 simulator 會一併啟動示範車隊模擬器（例：bundled-db,simulator）
COMPOSE_PROFILES=bundled-db：資料庫跟服務跑在同一台（預設）。
# 要把資料庫獨立到另一台時：把這個變數清空，並把 DB_HOST 指向那台。
# compose 其餘部分不必改，也不需要第二份設定檔。
COMPOSE_PROFILES=bundled-db
DB_HOST=postgres
DB_USER=syncdrive_user
DB_PASSWORD=
DB_NAME=syncdrive_t3

# ── 對外介面金鑰 ─────────────────────────────────────────────
# 協力廠商呼叫對外 API 時要帶的 x-api-key。
# NODE_ENV=production 時<strong>未設定會直接拒絕請求</strong>（fail-safe），不會靜默放行。
VTMS_API_KEY=

# ── CORS ────────────────────────────────────────────────────
# 我方前端的來源。留 * 等於任何網站都能用瀏覽器打我們的 API，正式機不要留 *。
# 範例：http://10.140.0.5,https://vtms.example.com
CORS_ORIGIN=

# ── 瀏覽帳密（兩組，互不共用）────────────────────────────────
# 內部（80）：圖台、完整技術文件、內部 Swagger、全部內部 API。
# 對外（3100）：廠商入口頁、三份對外文件、對外 Swagger。
#
# 兩組刻意分開：對外那組是要交出去的，換發時不該連我方自己的入口一起換。
# 由 bootstrap.sh 產生並寫入 deploy/.htpasswd 與 .htpasswd-external（nginx 掛載），
# 密碼同時記在這裡供查閱。
# 內部：圖台、內部 API、技術文件、內部 Swagger——全部
WEB_AUTH_USER=syncdrive
WEB_AUTH_PASSWORD=
# 廠商看圖台：只有圖台與內部 API，看不到技術文件與內部 Swagger
VENDOR_AUTH_USER=vendor
VENDOR_AUTH_PASSWORD=
# 廠商的對外入口（3100 埠）：介接文件與對外 Swagger
EXTERNAL_AUTH_USER=partner
EXTERNAL_AUTH_PASSWORD=

# ── MQTT ────────────────────────────────────────────────────
# 車端連進來的埠要綁在哪個介面。127.0.0.1＝只有本機；要讓車端或模擬器以外的
# 對象連進來才改 0.0.0.0，並用防火牆限制來源網段。
#
# broker 一律以 mosquitto.prod.conf 啟動：關閉匿名、帳密＋ACL（協議 §三）。
# 帳密由 bootstrap.sh 產生，逐一列在 deploy/mqtt-credentials.txt。
MQTT_BIND=127.0.0.1
MQTT_BACKEND_PASSWORD=
MQTT_SIMULATOR_PASSWORD=

# ── 資料表建立 ───────────────────────────────────────────────
# 本專案目前沒有 migration，DB_SYNCHRONIZE 是唯一會建立資料表的機制。
# 全新安裝必須是 true，否則服務啟動時第一支查詢就 relation does not exist，
# 然後進入重啟迴圈。
#
# 升級既有系統時要留意：synchronize 依實體定義調整結構，欄位改名在它眼中是
# 「刪一欄、加一欄」，可能靜默刪掉資料。正解是補 migration；在那之前，
# 升級前請先備份資料庫。
DB_SYNCHRONIZE=true

# ── 時區 ────────────────────────────────────────────────────
# 班表的時刻是營運當地時間：時間線上寫 05:05 就是現場的 05:05。
# 容器預設 UTC，不改的話調度引擎會把班表時刻當成 UTC，訂單晚八小時才發。
TZ=Asia/Taipei

# ── 即時調度引擎 ─────────────────────────────────────────────
# 引擎會依「部署中」的班表，在發車前自動建立營運訂單並發出 MQTT assign。
#
# 預設關閉。開之前先確認兩件事，否則會產生一整天沒有人執行的訂單：
#   1. 已經有一份班表按下「部署」（usage_status=in_use）
#   2. 車端（或模擬器）確實在線並訂閱 v1/vtms/<車號>/operation/assign
#
# 開啟前可先驗證，這兩支都不會寫入任何資料：
#   curl -u <內部帳密> http://<主機>/syncdrive-api/dispatch/plan     今日完整計畫
#   curl -u <內部帳密> http://<主機>/syncdrive-api/dispatch/dry-run  這一刻會發什麼
#
# 不重啟也能臨時開關（重啟後回到這裡的值）：
#   curl -u <內部帳密> -X POST http://<主機>/syncdrive-api/dispatch/enable \
#        -H 'Content-Type: application/json' -d '{"enabled":true}'
DISPATCH_ENABLED=false

# 多久檢查一次有沒有該發的班次（秒）
DISPATCH_TICK_SECONDS=5

# 提前多久下訂單（秒）。車端要時間拉任務、規劃路徑、開到起點，發車前才給會來不及。
DISPATCH_LEAD_SECONDS=90

# 補發窗口（秒）。引擎重啟後，發車時刻已過但還在這個窗口內的班次仍會補發；
# 超過就跳過——那已經不是「晚一點出發」而是「這班不用跑了」。
DISPATCH_CATCH_UP_SECONDS=300

# 要下訂單的任務類型，三種都要留著：
#   passenger    載客班次
#   dispatch     空車移動（整備出廠、入廠、讓站）
#   maintenance  整備班次（充電、行檢、保養、洗車、臨停、待命）
#
# 空車移動不發，車就一直停在場區，正線班次到點也開不出來；整備不發，整備格位的
# 佔用狀況、車輛卡片的徽章、班次運行紀錄的整備分頁全部是空的。
DISPATCH_TASK_TYPES=passenger,dispatch,maintenance

# ── 其他 ────────────────────────────────────────────────────
LOG_LEVEL=warn

# 設 1 時連 PMS 示範車的遙測也寫入時序庫。
# 正式車隊代號就是 PMS-01~11，所以要留軌跡回放與通訊中斷稽核就必須設 1；
# 一設磁碟就會以每天約 1 GB 的速度成長（11 台 × 1 Hz，保留 7 天）。
TELEMETRY_PERSIST_ALL=0

# 映像標籤；deploy.sh 會帶入 git 短雜湊，回滾時指定舊標籤即可
IMAGE_TAG=latest
