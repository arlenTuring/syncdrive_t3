{
  "name": "syncdrive-t3-simulator",
  "version": "0.1.0",
  "private": true,
  "description": "本地自駕車模擬器：以外部廠商身分連上 SyncDrive T3（GCP 或本地），收訂單、跑路線、回報狀態",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "build:web": "vite build --config web/vite.config.mts",
    "dev:web": "vite build --watch --config web/vite.config.mts",
    "map:import": "node scripts/import-map.js"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "mqtt": "^5.3.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.2.4",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^4.7.0",
    "lucide-react": "^1.14.0",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "tailwindcss": "^4.2.4",
    "typescript": "~6.0.2",
    "vite": "^5.4.21"
  }
}
