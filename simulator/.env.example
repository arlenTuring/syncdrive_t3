# 本地模擬器憑證
#
# 複製成 simulator/.env 後填值。這個檔案在 .gitignore 裡，不會進版控。
# 網頁只會顯示「哪幾組已設定」，不顯示值，也不能從網頁修改。

# ── 對外 API（3100 埠）───────────────────────────────────────
# 訂單生命週期走這一條，帶 x-api-key。與瀏覽帳密是不同的東西。
API_KEY=

# ── 內部 API（80 埠）─────────────────────────────────────────
# 圖資與調度引擎狀態走這一條。模擬器要知道站點座標才跑得動，而圖資是內部介面。
INTERNAL_USER=syncdrive
INTERNAL_PASSWORD=

# ── MQTT ────────────────────────────────────────────────────
# broker 關閉匿名連線，帳號必須等於車輛代號。ACL 只允許各車發布自己的路徑，
# 用錯帳號時發布會被靜默丟棄且不回錯誤。
#
# 逐台指定（GCP 上每台不同，值見 document/系統帳號與金鑰.md）
MQTT_PMS_01=
MQTT_PMS_02=
MQTT_PMS_03=
MQTT_PMS_04=
MQTT_PMS_05=
MQTT_PMS_06=
MQTT_PMS_07=
MQTT_PMS_08=
MQTT_PMS_09=
MQTT_PMS_10=
MQTT_PMS_11=

# 或全部共用一組（本地開發用；GCP 上不適用）
# MQTT_PASSWORD_ALL=

# ── 其他 ────────────────────────────────────────────────────
# 網頁埠
# PORT=4300
# 啟動時的預設目標：gcp 或 local
# SIM_TARGET=gcp
