# 複製本檔為 .env 後填入實際值；.env 不得提交進版控。
# Environment
NODE_ENV=development

# Database Configuration
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=syncdrive_user
DB_PASSWORD=change_me
DB_NAME=syncdrive_t3
# 設為 true 時印出 TypeORM SQL（除錯用）
DB_LOGGING=false

# Redis Configuration
REDIS_HOST=127.0.0.1
REDIS_PORT=6379

# MQTT Configuration
MQTT_URL=mqtt://127.0.0.1:1883

# ── 安全性設定 ───────────────────────────────
# 中心端指令 API 金鑰。設定後，呼叫 /syncdrive-api/command/* 必須帶 x-api-key 標頭。
# 留空則僅在開發模式放行（會印出警告）。正式環境務必設定。
VTMS_API_KEY=

# CORS 允許來源（逗號分隔）。留空或 * 代表全部放行（僅開發用）。
# 範例：http://localhost:5173,https://vtms.example.com
CORS_ORIGIN=*

# 後端監聽埠
PORT=3000

# 日誌等級：silent | error | warn | log | debug
LOG_LEVEL=warn

# 設為 1 時，連 PMS 示範車的遙測也寫入時序庫
TELEMETRY_PERSIST_ALL=0
