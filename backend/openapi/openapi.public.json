{
  "openapi": "3.0.0",
  "paths": {
    "/syncdrive-api/order/queryById": {
      "get": {
        "description": "車端拉取任務內容。營運任務狀態協議 §四 階段一：收到 operation/assign 之後以 order_id 取回完整任務（站點序列、各站動作、時刻）。",
        "operationId": "OrderController_queryOrder",
        "parameters": [
          {
            "name": "id",
            "required": true,
            "in": "query",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "401": {
            "description": "缺少或不正確的 x-api-key 標頭"
          }
        },
        "security": [
          {
            "x-api-key": []
          }
        ],
        "summary": "查詢訂單內容",
        "tags": [
          "對外｜營運任務"
        ]
      }
    },
    "/syncdrive-api/order/updateOrderProgress/{id}": {
      "put": {
        "description": "車端回報訂單契約狀態。營運任務狀態協議把這一支定為<strong>唯一真相來源</strong>——中心端資料庫的狀態判定以本 API 的 HTTP 成功回傳為準，不採信 MQTT 訊息。",
        "operationId": "OrderController_updateOrderProgress",
        "parameters": [
          {
            "name": "id",
            "required": true,
            "in": "path",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "status",
            "required": true,
            "in": "query",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "401": {
            "description": "缺少或不正確的 x-api-key 標頭"
          }
        },
        "security": [
          {
            "x-api-key": []
          }
        ],
        "summary": "更新訂單狀態 (SSOT)",
        "tags": [
          "對外｜營運任務"
        ]
      }
    },
    "/syncdrive-api/order/action/{actionId}": {
      "put": {
        "description": "節點任務（語音、開關門、聯鎖）的執行結果回報。營運任務狀態協議 §四 階段二。",
        "operationId": "OrderController_updateActionStatus",
        "parameters": [
          {
            "name": "actionId",
            "required": true,
            "in": "path",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "401": {
            "description": "缺少或不正確的 x-api-key 標頭"
          }
        },
        "security": [
          {
            "x-api-key": []
          }
        ],
        "summary": "車端以 action_id 回報站點動作狀態",
        "tags": [
          "對外｜營運任務"
        ]
      }
    },
    "/syncdrive-api/vehicles/eta/by-station": {
      "get": {
        "description": "以停靠點為主鍵，供站端顯示。一律列出全部停靠點（當下無車駛近者 etas 為空陣列），以利站端固定顯示版面。每站依 eta_at 由近到遠排序。建議輪詢間隔 60 秒。",
        "operationId": "VehicleEtaController_byStation",
        "parameters": [
          {
            "name": "limit_per_station",
            "required": false,
            "in": "query",
            "description": "每站回傳筆數，值域 1–10",
            "schema": {
              "type": "integer",
              "default": 3
            }
          },
          {
            "name": "station_id",
            "required": false,
            "in": "query",
            "description": "指定停靠點，可重複指定多個（如 ?station_id=station_3&station_id=station_4）",
            "schema": {}
          }
        ],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/VehicleEtaByStationResponseDto"
                }
              }
            }
          },
          "400": {
            "description": "參數格式錯誤",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EtaErrorDto"
                }
              }
            }
          },
          "401": {
            "description": "缺少或不正確的 x-api-key 標頭"
          }
        },
        "security": [
          {
            "x-api-key": []
          }
        ],
        "summary": "各停靠點接下來將抵達的車輛",
        "tags": [
          "對外｜車輛即時 ETA"
        ]
      }
    },
    "/syncdrive-api/vehicles/eta/by-vehicle": {
      "get": {
        "description": "以車輛為主鍵，供車輛追蹤畫面。next_stops 中 sequence=1 為車端當前目標站，eta 直接採用車端回報值；2 以後由中心端依班表外推，誤差隨站序累積。建議輪詢間隔 60 秒。",
        "operationId": "VehicleEtaController_byVehicle",
        "parameters": [
          {
            "name": "next_stops",
            "required": false,
            "in": "query",
            "description": "每車往後推算站數，值域 1–10",
            "schema": {
              "type": "integer",
              "default": 3
            }
          },
          {
            "name": "vehicle_code",
            "required": false,
            "in": "query",
            "description": "指定車輛，可重複指定多個（如 ?vehicle_code=PMS-01&vehicle_code=PMS-05）",
            "schema": {}
          }
        ],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/VehicleEtaByVehicleResponseDto"
                }
              }
            }
          },
          "400": {
            "description": "參數格式錯誤",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EtaErrorDto"
                }
              }
            }
          },
          "401": {
            "description": "缺少或不正確的 x-api-key 標頭"
          }
        },
        "security": [
          {
            "x-api-key": []
          }
        ],
        "summary": "各車輛接下來將抵達的停靠點",
        "tags": [
          "對外｜車輛即時 ETA"
        ]
      }
    },
    "/syncdrive-api/operation-shift/timetable/trips": {
      "get": {
        "description": "讀取最新「已發布」且有 plan 的班表；若無已發布則 fallback 最新草稿。回傳全部任務類型（正線／保養／行檢／充電／待命／調度等，略過 transition）。可用 from/to 過濾卡時間重疊區間。",
        "operationId": "OperationShiftController_getTimetableTrips",
        "parameters": [
          {
            "name": "from",
            "required": false,
            "in": "query",
            "description": "HH:MM:SS 或秒，預設 00:00:00",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "to",
            "required": false,
            "in": "query",
            "description": "HH:MM:SS 或秒，預設 24:00:00",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TimetableTripsResponseDto"
                }
              }
            }
          },
          "401": {
            "description": "缺少或不正確的 x-api-key 標頭"
          },
          "404": {
            "description": "庫內沒有任何含排班結果的班表"
          }
        },
        "security": [
          {
            "x-api-key": []
          }
        ],
        "summary": "取得班表班次清單（含各站時刻）",
        "tags": [
          "對外｜班表計畫"
        ]
      }
    },
    "/syncdrive-api/operation-shift/timetable/station-etas": {
      "get": {
        "description": "由班表推算之站點事件流；vehicle_id 暫為 null。可用 from/to、station_id 濾波。",
        "operationId": "OperationShiftController_getStationEtas",
        "parameters": [
          {
            "name": "from",
            "required": false,
            "in": "query",
            "description": "HH:MM:SS 或秒，預設 00:00:00",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "to",
            "required": false,
            "in": "query",
            "description": "HH:MM:SS 或秒，預設 24:00:00",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "station_id",
            "required": false,
            "in": "query",
            "description": "只取單一站",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/StationEtasResponseDto"
                }
              }
            }
          },
          "401": {
            "description": "缺少或不正確的 x-api-key 標頭"
          },
          "404": {
            "description": "庫內沒有任何含排班結果的班表"
          }
        },
        "security": [
          {
            "x-api-key": []
          }
        ],
        "summary": "取得各站計畫 ETA（抵達／離站）",
        "tags": [
          "對外｜班表計畫"
        ]
      }
    }
  },
  "info": {
    "title": "SyncDrive-T3 對外介面",
    "description": "台智駕 SyncDrive T3 車輛監控系統對外提供的介面契約。所有端點需帶 `x-api-key` 標頭。詳細語意見各端點說明與規格書。",
    "version": "1.0",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "securitySchemes": {
      "x-api-key": {
        "type": "apiKey",
        "in": "header",
        "name": "x-api-key"
      }
    },
    "schemas": {
      "EtaErrorDto": {
        "type": "object",
        "properties": {
          "error": {
            "type": "string",
            "enum": [
              "INVALID_PARAM",
              "UNAUTHORIZED",
              "NOT_FOUND",
              "RATE_LIMITED",
              "SERVICE_DEGRADED"
            ]
          },
          "detail": {
            "type": "string",
            "example": "limit_per_station 必須為 1 至 10 的整數"
          }
        },
        "required": [
          "error",
          "detail"
        ]
      },
      "EtaMetaDto": {
        "type": "object",
        "properties": {
          "generated_at": {
            "type": "number",
            "example": 1786842000000,
            "description": "中心端產生本次快照的時刻"
          },
          "generated_clock": {
            "type": "string",
            "example": "09:00:00",
            "description": "可直接顯示為「資料更新於」"
          },
          "shift_id": {
            "type": "object",
            "nullable": true,
            "example": "OS-DRAFT-MSEEXIN9",
            "description": "計畫值所依據的班表；無可用班表時為 null"
          },
          "source": {
            "type": "string",
            "enum": [
              "published",
              "draft_fallback",
              "none"
            ],
            "description": "published＝已發布班表；draft_fallback＝草稿，計畫值僅供參考，不應對外顯示為正式時刻；none＝無班表，plan 全為 null"
          },
          "data_quality": {
            "type": "string",
            "enum": [
              "OK",
              "DEGRADED",
              "DOWN"
            ],
            "description": "DEGRADED＝部分車輛逾時或班表未載入，須對 UNKNOWN 者標示資料中斷；DOWN＝無法取得任何車輛資料，必須停止顯示 ETA"
          }
        },
        "required": [
          "generated_at",
          "generated_clock",
          "shift_id",
          "source",
          "data_quality"
        ]
      },
      "EtaPlanDto": {
        "type": "object",
        "properties": {
          "planned_arrival_at": {
            "type": "object",
            "nullable": true,
            "example": 1786842010000
          },
          "planned_arrival_clock": {
            "type": "object",
            "nullable": true,
            "example": "09:00:10"
          },
          "planned_departure_at": {
            "type": "object",
            "nullable": true,
            "description": "僅於該停靠點為此班次起站，或 arrival_state 為 AT_STATION 時有值"
          },
          "planned_departure_clock": {
            "type": "object",
            "nullable": true
          },
          "delay_seconds": {
            "type": "object",
            "nullable": true,
            "example": 13,
            "description": "eta_at 減 planned_arrival_at，單位秒。正值＝晚於計畫"
          },
          "delay_state": {
            "type": "string",
            "enum": [
              "EARLY",
              "ON_TIME",
              "MINOR_DELAY",
              "MAJOR_DELAY",
              "NO_PLAN"
            ],
            "description": "暫定定義，門檻未經營運確認。現階段請以 delay_seconds 為準"
          }
        },
        "required": [
          "planned_arrival_at",
          "planned_arrival_clock",
          "planned_departure_at",
          "planned_departure_clock",
          "delay_seconds",
          "delay_state"
        ]
      },
      "StationEtaEntryDto": {
        "type": "object",
        "properties": {
          "vehicle_code": {
            "type": "string",
            "example": "PMS-05"
          },
          "order_id": {
            "type": "object",
            "nullable": true,
            "example": "260816-ST0007"
          },
          "trip_code": {
            "type": "object",
            "nullable": true,
            "example": "ST0007",
            "description": "路線代號＋發車時刻 HHMM"
          },
          "route_code": {
            "type": "object",
            "nullable": true,
            "example": "ST"
          },
          "route_name": {
            "type": "object",
            "nullable": true,
            "example": "S2W上行 > T3上行"
          },
          "vehicle_phase": {
            "type": "string",
            "nullable": true,
            "enum": [
              "TRANSITING",
              "FAULTED"
            ],
            "description": "車端營運階段，原值透傳；資料逾時或車端未提供時為 null"
          },
          "arrival_state": {
            "type": "string",
            "enum": [
              "EN_ROUTE",
              "APPROACHING",
              "DOCKING",
              "AT_STATION",
              "DEPARTED",
              "UNKNOWN"
            ],
            "description": "APPROACHING＝即將進站（eta ≤ 60 秒或距離 ≤ 200 公尺）；EN_ROUTE＝預計到達；UNKNOWN＝車端資料逾時或缺少目標站"
          },
          "eta_seconds": {
            "type": "object",
            "nullable": true,
            "example": 25,
            "description": "以 observed_at 為基準的剩餘秒數，非以收到回應的時刻為基準"
          },
          "eta_at": {
            "type": "object",
            "nullable": true,
            "example": 1786842023000,
            "description": "恆等於 observed_at + eta_seconds × 1000。倒數計時必須用這個欄位"
          },
          "eta_clock": {
            "type": "object",
            "nullable": true,
            "example": "09:00:23"
          },
          "distance_to_station_m": {
            "type": "object",
            "nullable": true,
            "example": 120,
            "description": "路徑距離，公尺"
          },
          "plan": {
            "$ref": "#/components/schemas/EtaPlanDto"
          },
          "observed_at": {
            "type": "number",
            "example": 1786841998000,
            "description": "車端回報時刻"
          },
          "observed_clock": {
            "type": "string",
            "example": "08:59:58"
          },
          "data_age_seconds": {
            "type": "number",
            "example": 2,
            "description": "generated_at 減 observed_at。失聯是以「資料變舊」呈現而非欄位消失，不可只用欄位是否存在判斷"
          }
        },
        "required": [
          "vehicle_code",
          "order_id",
          "trip_code",
          "route_code",
          "route_name",
          "vehicle_phase",
          "arrival_state",
          "eta_seconds",
          "eta_at",
          "eta_clock",
          "distance_to_station_m",
          "plan",
          "observed_at",
          "observed_clock",
          "data_age_seconds"
        ]
      },
      "StationEtaEventDto": {
        "type": "object",
        "properties": {
          "station_id": {
            "type": "string",
            "example": "station_4"
          },
          "station_alias": {
            "type": "string",
            "example": "T3上行",
            "description": "地圖上的停靠點別名，顯示用主標題"
          },
          "station_name": {
            "type": "string",
            "example": "T3上行",
            "description": "路線站序上的名稱"
          },
          "role": {
            "type": "string",
            "enum": [
              "origin",
              "intermediate",
              "terminal"
            ]
          },
          "eta_arrive": {
            "type": "object",
            "nullable": true,
            "example": "00:10:40",
            "description": "計畫抵達；起站為 null"
          },
          "eta_depart": {
            "type": "object",
            "nullable": true,
            "example": "00:11:30",
            "description": "起站／途經＝出發；末站＝靠站完成（即該班次卡結束）"
          },
          "eta_arrive_second": {
            "type": "object",
            "nullable": true,
            "example": 640
          },
          "eta_depart_second": {
            "type": "object",
            "nullable": true,
            "example": 690
          },
          "non_stop": {
            "type": "boolean",
            "example": false,
            "description": "到站與離站同一秒（不停靠／途經）"
          },
          "base_dwell_seconds": {
            "type": "number",
            "example": 36
          },
          "dwell_seconds": {
            "type": "number",
            "example": 50
          },
          "buffer_seconds": {
            "type": "number",
            "example": 14,
            "description": "有效停靠 − 設定停靠，恆 ≥ 0"
          },
          "trip_code": {
            "type": "string",
            "example": "ST0007"
          },
          "block_id": {
            "type": "string",
            "example": "b-st"
          },
          "timeline_row": {
            "type": "number",
            "example": 1
          },
          "route_code": {
            "type": "object",
            "nullable": true,
            "example": "ST"
          },
          "route_name": {
            "type": "object",
            "nullable": true,
            "example": "S2W上行 > T3上行"
          },
          "vehicle_id": {
            "type": "string",
            "nullable": true,
            "description": "<strong>固定為 null。</strong>計畫值不含車輛對應——哪一列由哪一台車擔任，是當日才決定的。要車輛識別請改用即時 ETA 介面。"
          }
        },
        "required": [
          "station_id",
          "station_alias",
          "station_name",
          "role",
          "eta_arrive",
          "eta_depart",
          "eta_arrive_second",
          "eta_depart_second",
          "non_stop",
          "base_dwell_seconds",
          "dwell_seconds",
          "buffer_seconds",
          "trip_code",
          "block_id",
          "timeline_row",
          "route_code",
          "route_name",
          "vehicle_id"
        ]
      },
      "StationEtaFilterDto": {
        "type": "object",
        "properties": {
          "from": {
            "type": "string",
            "example": "00:00:00"
          },
          "to": {
            "type": "string",
            "example": "24:00:00"
          },
          "from_second": {
            "type": "number",
            "example": 0,
            "description": "當日第幾秒"
          },
          "to_second": {
            "type": "number",
            "example": 86400
          },
          "station_id": {
            "type": "object",
            "nullable": true,
            "example": "station_4"
          },
          "passenger_stops_only": {
            "type": "boolean",
            "example": true,
            "description": "固定為 true：只回正線班次的站點事件"
          }
        },
        "required": [
          "from",
          "to",
          "from_second",
          "to_second",
          "station_id",
          "passenger_stops_only"
        ]
      },
      "StationEtaGroupDto": {
        "type": "object",
        "properties": {
          "station_id": {
            "type": "string",
            "example": "station_4"
          },
          "station_name": {
            "type": "string",
            "example": "T3上行"
          },
          "etas": {
            "description": "依 eta_at 由近到遠排序；當下無車駛近時為空陣列",
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/StationEtaEntryDto"
            }
          }
        },
        "required": [
          "station_id",
          "station_name",
          "etas"
        ]
      },
      "StationEtasResponseDto": {
        "type": "object",
        "properties": {
          "meta": {
            "$ref": "#/components/schemas/TimetableMetaDto"
          },
          "filter": {
            "$ref": "#/components/schemas/StationEtaFilterDto"
          },
          "eta_count": {
            "type": "number",
            "example": 4
          },
          "etas": {
            "description": "依時間排序的站點事件流",
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/StationEtaEventDto"
            }
          },
          "stations": {
            "description": "同一份事件依停靠點分組。<strong>會列出地圖上全部停靠點</strong>，包含目前沒有任何班次的（etas 為空陣列），方便站端固定顯示版面而不必自己補齊清單。",
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/StationEtaGroupDto"
            }
          }
        },
        "required": [
          "meta",
          "filter",
          "eta_count",
          "etas",
          "stations"
        ]
      },
      "TimetableFilterDto": {
        "type": "object",
        "properties": {
          "from": {
            "type": "string",
            "example": "00:00:00"
          },
          "to": {
            "type": "string",
            "example": "24:00:00"
          },
          "from_second": {
            "type": "number",
            "example": 0,
            "description": "當日第幾秒"
          },
          "to_second": {
            "type": "number",
            "example": 86400
          }
        },
        "required": [
          "from",
          "to",
          "from_second",
          "to_second"
        ]
      },
      "TimetableMetaDto": {
        "type": "object",
        "properties": {
          "shift_id": {
            "type": "string",
            "example": "OS-DRAFT-MSEEXIN9",
            "description": "這份班表的識別碼"
          },
          "name": {
            "type": "string",
            "example": "模擬正線"
          },
          "publish_status": {
            "type": "string",
            "enum": [
              "draft",
              "published"
            ],
            "description": "班表本身的發布狀態"
          },
          "source": {
            "type": "string",
            "enum": [
              "published",
              "draft_fallback"
            ],
            "description": "published＝讀到已發布班表；draft_fallback＝庫內沒有已發布的，退而取用最新草稿，此時時刻僅供參考，不應對外顯示為正式時刻"
          },
          "generated_at": {
            "type": "object",
            "nullable": true,
            "example": "2026-08-19T00:53:59.220Z",
            "description": "班表產生時刻"
          },
          "updated_at": {
            "type": "string",
            "example": "1787115236800",
            "description": "最後更新（Epoch 毫秒字串）"
          },
          "map_id": {
            "type": "object",
            "nullable": true,
            "description": "這份班表所依據的地圖"
          }
        },
        "required": [
          "shift_id",
          "name",
          "publish_status",
          "source",
          "generated_at",
          "updated_at",
          "map_id"
        ]
      },
      "TimetableTripDto": {
        "type": "object",
        "properties": {
          "trip_code": {
            "type": "string",
            "example": "ST0007",
            "description": "路線代號＋發車時刻 HHMM"
          },
          "block_id": {
            "type": "string",
            "example": "task-1786018029893-faqq",
            "description": "班次卡的內部識別碼"
          },
          "timeline_row": {
            "type": "number",
            "example": 1,
            "description": "這一趟屬於班表上的第幾列"
          },
          "task_type": {
            "type": "string",
            "example": "passenger",
            "description": "回傳全部任務類型：passenger 正線、servicing 保養、inspection 行檢、charging 充電、standby 待命、dispatch 調度等。整備類通常無站序，stations 為空陣列"
          },
          "label": {
            "type": "string",
            "example": "正線"
          },
          "source": {
            "type": "string",
            "example": "template_bar",
            "description": "這張卡的產生來源"
          },
          "route_id": {
            "type": "object",
            "nullable": true
          },
          "route_code": {
            "type": "object",
            "nullable": true,
            "example": "ST"
          },
          "route_name": {
            "type": "object",
            "nullable": true,
            "example": "S2W上行 > T3上行"
          },
          "card_start": {
            "type": "string",
            "example": "00:07:40",
            "description": "班次卡開始（＝起站 departure）"
          },
          "card_end": {
            "type": "string",
            "example": "00:11:30",
            "description": "班次卡結束（＝末站 dwell_complete）"
          },
          "card_start_second": {
            "type": "number",
            "example": 460
          },
          "card_end_second": {
            "type": "number",
            "example": 690
          },
          "stations": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/TimetableTripStationDto"
            }
          }
        },
        "required": [
          "trip_code",
          "block_id",
          "timeline_row",
          "task_type",
          "label",
          "source",
          "route_id",
          "route_code",
          "route_name",
          "card_start",
          "card_end",
          "card_start_second",
          "card_end_second",
          "stations"
        ]
      },
      "TimetableTripStationDto": {
        "type": "object",
        "properties": {
          "order": {
            "type": "number",
            "example": 1,
            "description": "站序，自 1 起算"
          },
          "station_id": {
            "type": "string",
            "example": "station_4"
          },
          "station_name": {
            "type": "string",
            "example": "T3上行"
          },
          "role": {
            "type": "string",
            "enum": [
              "origin",
              "intermediate",
              "terminal"
            ],
            "description": "origin＝只看 departure（arrival 固定 null，抵達屬上一卡末站）；intermediate＝arrival ＋ departure；terminal＝arrival ＋ dwell_complete（完成靠站，不稱出發）"
          },
          "arrival": {
            "type": "object",
            "nullable": true,
            "example": "00:10:40",
            "description": "計畫抵達；起站為 null"
          },
          "departure": {
            "type": "object",
            "nullable": true,
            "example": "00:07:40",
            "description": "計畫離站；末站為 null"
          },
          "dwell_complete": {
            "type": "object",
            "nullable": true,
            "example": "00:11:30",
            "description": "靠站完成（＝該班次卡結束）。僅末站有值"
          },
          "base_dwell_seconds": {
            "type": "number",
            "example": 40,
            "description": "設定的靠站秒數，不含緩衝"
          },
          "dwell_seconds": {
            "type": "number",
            "example": 50,
            "description": "有效靠站秒數，含緩衝"
          },
          "travel_to_next_seconds": {
            "type": "object",
            "nullable": true,
            "example": 100,
            "description": "到下一站的行駛秒數；末站為 null"
          }
        },
        "required": [
          "order",
          "station_id",
          "station_name",
          "role",
          "arrival",
          "departure",
          "dwell_complete",
          "base_dwell_seconds",
          "dwell_seconds",
          "travel_to_next_seconds"
        ]
      },
      "TimetableTripsResponseDto": {
        "type": "object",
        "properties": {
          "meta": {
            "$ref": "#/components/schemas/TimetableMetaDto"
          },
          "filter": {
            "$ref": "#/components/schemas/TimetableFilterDto"
          },
          "trip_count": {
            "type": "number",
            "example": 26
          },
          "trips": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/TimetableTripDto"
            }
          }
        },
        "required": [
          "meta",
          "filter",
          "trip_count",
          "trips"
        ]
      },
      "VehicleEtaByStationResponseDto": {
        "type": "object",
        "properties": {
          "meta": {
            "$ref": "#/components/schemas/EtaMetaDto"
          },
          "station_count": {
            "type": "number",
            "example": 10,
            "description": "等於 stations 陣列長度；未指定 station_id 時為全部停靠點"
          },
          "stations": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/StationEtaGroupDto"
            }
          }
        },
        "required": [
          "meta",
          "station_count",
          "stations"
        ]
      },
      "VehicleEtaByVehicleResponseDto": {
        "type": "object",
        "properties": {
          "meta": {
            "$ref": "#/components/schemas/EtaMetaDto"
          },
          "vehicle_count": {
            "type": "number",
            "example": 11,
            "description": "等於 vehicles 陣列長度"
          },
          "vehicles": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/VehicleEtaEntryDto"
            }
          }
        },
        "required": [
          "meta",
          "vehicle_count",
          "vehicles"
        ]
      },
      "VehicleEtaEntryDto": {
        "type": "object",
        "properties": {
          "vehicle_code": {
            "type": "string",
            "example": "PMS-05"
          },
          "vehicle_phase": {
            "type": "string",
            "nullable": true,
            "enum": [
              "TRANSITING",
              "FAULTED"
            ]
          },
          "order_id": {
            "type": "object",
            "nullable": true,
            "example": "260816-ST0007"
          },
          "trip_code": {
            "type": "object",
            "nullable": true,
            "example": "ST0007"
          },
          "route_code": {
            "type": "object",
            "nullable": true,
            "example": "ST"
          },
          "route_name": {
            "type": "object",
            "nullable": true,
            "example": "S2W上行 > T3上行"
          },
          "position": {
            "nullable": true,
            "description": "車端資料逾時時為 null",
            "type": "object",
            "allOf": [
              {
                "$ref": "#/components/schemas/VehiclePositionDto"
              }
            ]
          },
          "next_stops": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/VehicleNextStopDto"
            }
          },
          "observed_at": {
            "type": "number",
            "example": 1786841998000
          },
          "observed_clock": {
            "type": "string",
            "example": "08:59:58"
          },
          "data_age_seconds": {
            "type": "number",
            "example": 2
          }
        },
        "required": [
          "vehicle_code",
          "vehicle_phase",
          "order_id",
          "trip_code",
          "route_code",
          "route_name",
          "position",
          "next_stops",
          "observed_at",
          "observed_clock",
          "data_age_seconds"
        ]
      },
      "VehicleNextStopDto": {
        "type": "object",
        "properties": {
          "sequence": {
            "type": "number",
            "example": 1,
            "description": "自 1 起算。sequence=1 為車端當前目標站，eta 直接採用車端回報值；2 以後由中心端依班表站間旅行時間外推，誤差隨站序累積"
          },
          "station_id": {
            "type": "string",
            "example": "station_4"
          },
          "station_name": {
            "type": "string",
            "example": "T3上行"
          },
          "arrival_state": {
            "type": "string",
            "enum": [
              "EN_ROUTE",
              "APPROACHING",
              "DOCKING",
              "AT_STATION",
              "DEPARTED",
              "UNKNOWN"
            ]
          },
          "eta_seconds": {
            "type": "object",
            "nullable": true,
            "example": 25
          },
          "eta_at": {
            "type": "object",
            "nullable": true,
            "example": 1786842023000
          },
          "eta_clock": {
            "type": "object",
            "nullable": true,
            "example": "09:00:23"
          },
          "distance_to_station_m": {
            "type": "object",
            "nullable": true,
            "example": 120
          },
          "plan": {
            "$ref": "#/components/schemas/EtaPlanDto"
          }
        },
        "required": [
          "sequence",
          "station_id",
          "station_name",
          "arrival_state",
          "eta_seconds",
          "eta_at",
          "eta_clock",
          "distance_to_station_m",
          "plan"
        ]
      },
      "VehiclePositionDto": {
        "type": "object",
        "properties": {
          "latitude": {
            "type": "number",
            "example": 25.077612,
            "description": "WGS84 緯度"
          },
          "longitude": {
            "type": "number",
            "example": 121.232545,
            "description": "WGS84 經度"
          },
          "heading": {
            "type": "number",
            "example": 1.49,
            "description": "車頭朝向角，弳度"
          },
          "velocity_kph": {
            "type": "number",
            "example": 10.5,
            "description": "公里／小時"
          }
        },
        "required": [
          "latitude",
          "longitude",
          "heading",
          "velocity_kph"
        ]
      }
    }
  }
}
