{
  "openapi": "3.0.0",
  "paths": {
    "/syncdrive-api/order/queryById": {
      "get": {
        "description": "取得指定訂單之站序、各站計畫時刻與起訖點座標。`operation/assign` 僅傳遞訂單編號，任務內容以本端點取得。中心端不提供路徑，路徑由車端依站序與場域座標自行規劃。欄位定義見車端介接說明書 §3.2。",
        "operationId": "OrderController_queryOrder",
        "parameters": [
          {
            "name": "id",
            "required": true,
            "in": "query",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "訂單內容"
          },
          "400": {
            "description": "缺少 id 參數"
          },
          "401": {
            "description": "缺少或不正確的 x-api-key 標頭"
          },
          "404": {
            "description": "訂單不存在"
          }
        },
        "security": [
          {
            "x-api-key": []
          }
        ],
        "summary": "依訂單編號取得任務內容",
        "tags": [
          "營運任務"
        ]
      }
    },
    "/syncdrive-api/order/updateOrderProgress/{id}": {
      "put": {
        "description": "本端點為訂單狀態之唯一權威來源。中心端之訂單狀態僅依本端點的 HTTP 成功回應變更，不採信 MQTT 訊息中的狀態欄位。允許之狀態轉移：PENDING → PROCESSING；PROCESSING → END 或 FAULTED；FAULTED → PROCESSING 或 END。END 為終態。欄位定義見車端介接說明書 §3.3。",
        "operationId": "OrderController_updateOrderProgress",
        "parameters": [
          {
            "name": "id",
            "required": true,
            "in": "path",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "status",
            "required": true,
            "in": "query",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "更新後之訂單"
          },
          "400": {
            "description": "status 值不合法，或不允許之狀態轉移"
          },
          "401": {
            "description": "缺少或不正確的 x-api-key 標頭"
          },
          "404": {
            "description": "訂單不存在"
          }
        },
        "security": [
          {
            "x-api-key": []
          }
        ],
        "summary": "回報訂單狀態",
        "tags": [
          "營運任務"
        ]
      }
    },
    "/syncdrive-api/order/action/{actionId}": {
      "put": {
        "description": "回報站點動作（發車前語音、開關門、路口聯鎖、精準對位停靠）之執行結果。動作代碼與觸發時機見營運任務狀態協議 §六.1，欄位定義見車端介接說明書 §3.4。",
        "operationId": "OrderController_updateActionStatus",
        "parameters": [
          {
            "name": "actionId",
            "required": true,
            "in": "path",
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UpdateActionStatusDto"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "更新後之動作狀態"
          },
          "400": {
            "description": "status 值不合法"
          },
          "401": {
            "description": "缺少或不正確的 x-api-key 標頭"
          },
          "404": {
            "description": "動作識別碼不存在"
          }
        },
        "security": [
          {
            "x-api-key": []
          }
        ],
        "summary": "回報站點動作執行結果",
        "tags": [
          "營運任務"
        ]
      }
    },
    "/syncdrive-api/vehicles/eta/by-station": {
      "get": {
        "description": "以停靠點為主鍵，回傳各停靠點接下來將抵達之車輛。一律列出全部停靠點，當下無車輛駛近者 etas 為空陣列。每站之 etas 依 eta_at 由近至遠排序。建議輪詢間隔 60 秒。",
        "operationId": "VehicleEtaController_byStation",
        "parameters": [
          {
            "name": "limit_per_station",
            "required": false,
            "in": "query",
            "description": "每站回傳筆數，值域 1–10",
            "schema": {
              "type": "integer",
              "default": 3
            }
          },
          {
            "name": "station_id",
            "required": false,
            "in": "query",
            "description": "指定停靠點，可重複指定多個（如 ?station_id=station_3&station_id=station_4）",
            "schema": {}
          }
        ],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/VehicleEtaByStationResponseDto"
                }
              }
            }
          },
          "400": {
            "description": "參數格式錯誤",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EtaErrorDto"
                }
              }
            }
          },
          "401": {
            "description": "缺少或不正確的 x-api-key 標頭"
          }
        },
        "security": [
          {
            "x-api-key": []
          }
        ],
        "summary": "各停靠點接下來將抵達的車輛",
        "tags": [
          "車輛即時 ETA"
        ]
      }
    },
    "/syncdrive-api/vehicles/eta/by-vehicle": {
      "get": {
        "description": "以車輛為主鍵，回傳各車輛接下來將抵達之停靠點。next_stops 中 sequence 為 1 者取自車端回報之 current_leg，sequence 2 以後由中心端依班表計畫時刻外推。建議輪詢間隔 60 秒。",
        "operationId": "VehicleEtaController_byVehicle",
        "parameters": [
          {
            "name": "next_stops",
            "required": false,
            "in": "query",
            "description": "每車往後推算站數，值域 1–10",
            "schema": {
              "type": "integer",
              "default": 3
            }
          },
          {
            "name": "vehicle_code",
            "required": false,
            "in": "query",
            "description": "指定車輛，可重複指定多個（如 ?vehicle_code=PMS-01&vehicle_code=PMS-05）",
            "schema": {}
          }
        ],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/VehicleEtaByVehicleResponseDto"
                }
              }
            }
          },
          "400": {
            "description": "參數格式錯誤",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EtaErrorDto"
                }
              }
            }
          },
          "401": {
            "description": "缺少或不正確的 x-api-key 標頭"
          }
        },
        "security": [
          {
            "x-api-key": []
          }
        ],
        "summary": "各車輛接下來將抵達的停靠點",
        "tags": [
          "車輛即時 ETA"
        ]
      }
    },
    "/syncdrive-api/operation-shift/timetable/trips": {
      "get": {
        "description": "回傳目前使用中班表之全部班次，含各班次的逐站計畫抵達與發車時刻。任務類型涵蓋正線、保養、行檢、充電、待命與調度。本端點為計畫值，與車輛實際位置無關；即時值見車輛即時 ETA。",
        "operationId": "OperationShiftController_getTimetableTrips",
        "parameters": [
          {
            "name": "from",
            "required": false,
            "in": "query",
            "description": "HH:MM:SS 或秒，預設 00:00:00",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "to",
            "required": false,
            "in": "query",
            "description": "HH:MM:SS 或秒，預設 24:00:00",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TimetableTripsResponseDto"
                }
              }
            }
          },
          "401": {
            "description": "缺少或不正確的 x-api-key 標頭"
          },
          "404": {
            "description": "庫內沒有任何含排班結果的班表"
          }
        },
        "security": [
          {
            "x-api-key": []
          }
        ],
        "summary": "取得班次清單與各站計畫時刻",
        "tags": [
          "班表計畫"
        ]
      }
    },
    "/syncdrive-api/operation-shift/timetable/station-etas": {
      "get": {
        "description": "以停靠點為主鍵，回傳由班表推算之抵達與離站事件序列。本端點為計畫值，事件不帶車輛識別；需要車輛識別時使用車輛即時 ETA。可用 from／to 限定時間區間，station_id 限定單一停靠點。",
        "operationId": "OperationShiftController_getStationEtas",
        "parameters": [
          {
            "name": "from",
            "required": false,
            "in": "query",
            "description": "HH:MM:SS 或秒，預設 00:00:00",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "to",
            "required": false,
            "in": "query",
            "description": "HH:MM:SS 或秒，預設 24:00:00",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "station_id",
            "required": false,
            "in": "query",
            "description": "只取單一站",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/StationEtasResponseDto"
                }
              }
            }
          },
          "401": {
            "description": "缺少或不正確的 x-api-key 標頭"
          },
          "404": {
            "description": "庫內沒有任何含排班結果的班表"
          }
        },
        "security": [
          {
            "x-api-key": []
          }
        ],
        "summary": "取得各停靠點之計畫事件流",
        "tags": [
          "班表計畫"
        ]
      }
    },
    "/syncdrive-api/auth/token": {
      "post": {
        "description": "以配發之帳號密碼申請存取憑據。回應包含後續呼叫各介面所需的 `x-api-key`，以及連線 MQTT broker 所需的 CA 憑證與各車之用戶端憑證與私鑰。金鑰於 `expires_at` 之後失效，屆時重新呼叫本端點取得新金鑰。金鑰值僅於本回應出現一次，中心端僅保存其雜湊值，無法回查。欄位定義見介接說明書 §一。",
        "operationId": "PartnerAccessController_issue",
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/IssueTokenDto"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "API 金鑰與 MQTT 用戶端憑證",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/IssuedTokenDto"
                }
              }
            }
          },
          "400": {
            "description": "ttl_minutes 逾值域，或 vehicle_codes 含未簽發之車輛代號"
          },
          "401": {
            "description": "帳號或密碼不正確"
          }
        },
        "summary": "申請 API 金鑰與 MQTT 用戶端憑證",
        "tags": [
          "存取憑據"
        ]
      }
    }
  },
  "info": {
    "title": "SyncDrive-T3 介接介面",
    "description": "台智駕 SyncDrive T3 車輛行車管理系統之介接契約。除申請存取憑據之端點外，其餘端點均需帶 `x-api-key` 標頭；金鑰以「存取憑據」分組之端點申請取得。共通規範見介接說明書，車端介面之欄位定義見車端介接說明書。",
    "version": "1.0",
    "contact": {}
  },
  "tags": [
    {
      "name": "存取憑據"
    },
    {
      "name": "營運任務"
    },
    {
      "name": "班表計畫"
    },
    {
      "name": "車輛即時 ETA"
    }
  ],
  "servers": [],
  "components": {
    "securitySchemes": {
      "x-api-key": {
        "type": "apiKey",
        "in": "header",
        "name": "x-api-key"
      }
    },
    "schemas": {
      "EtaErrorDto": {
        "type": "object",
        "properties": {
          "error": {
            "type": "string",
            "enum": [
              "INVALID_PARAM",
              "UNAUTHORIZED",
              "NOT_FOUND",
              "RATE_LIMITED",
              "SERVICE_DEGRADED"
            ]
          },
          "detail": {
            "type": "string",
            "example": "limit_per_station 必須為 1 至 10 的整數"
          }
        },
        "required": [
          "error",
          "detail"
        ]
      },
      "EtaMetaDto": {
        "type": "object",
        "properties": {
          "generated_at": {
            "type": "number",
            "example": 1786842000000,
            "description": "中心端產生本次快照的時刻"
          },
          "generated_clock": {
            "type": "string",
            "example": "09:00:00",
            "description": "可直接顯示為「資料更新於」"
          },
          "shift_id": {
            "type": "object",
            "nullable": true,
            "example": "OS-DRAFT-MSEEXIN9",
            "description": "計畫值所依據的班表；無可用班表時為 null"
          },
          "source": {
            "type": "string",
            "enum": [
              "published",
              "draft_fallback",
              "none"
            ],
            "description": "published＝已發布班表；draft_fallback＝草稿，計畫值僅供參考，不得作為正式時刻使用；none＝無班表，plan 全為 null"
          },
          "data_quality": {
            "type": "string",
            "enum": [
              "OK",
              "DEGRADED",
              "DOWN"
            ],
            "description": "DEGRADED＝部分車輛逾時或班表未載入，須對 UNKNOWN 者標示資料中斷；DOWN＝無法取得任何車輛資料，必須停止顯示 ETA"
          }
        },
        "required": [
          "generated_at",
          "generated_clock",
          "shift_id",
          "source",
          "data_quality"
        ]
      },
      "EtaPlanDto": {
        "type": "object",
        "properties": {
          "planned_arrival_at": {
            "type": "object",
            "nullable": true,
            "example": 1786842010000
          },
          "planned_arrival_clock": {
            "type": "object",
            "nullable": true,
            "example": "09:00:10"
          },
          "planned_departure_at": {
            "type": "object",
            "nullable": true,
            "description": "僅於該停靠點為此班次起站，或 arrival_state 為 AT_STATION 時有值"
          },
          "planned_departure_clock": {
            "type": "object",
            "nullable": true
          },
          "delay_seconds": {
            "type": "object",
            "nullable": true,
            "example": 13,
            "description": "eta_at 減 planned_arrival_at，單位秒。正值＝晚於計畫"
          },
          "delay_state": {
            "type": "string",
            "enum": [
              "EARLY",
              "ON_TIME",
              "MINOR_DELAY",
              "MAJOR_DELAY",
              "NO_PLAN"
            ],
            "description": "暫定定義，門檻未經營運確認。現階段請以 delay_seconds 為準"
          }
        },
        "required": [
          "planned_arrival_at",
          "planned_arrival_clock",
          "planned_departure_at",
          "planned_departure_clock",
          "delay_seconds",
          "delay_state"
        ]
      },
      "IssueTokenDto": {
        "type": "object",
        "properties": {
          "username": {
            "type": "string",
            "description": "配發之帳號",
            "example": "partner"
          },
          "password": {
            "type": "string",
            "description": "配發之密碼"
          },
          "ttl_minutes": {
            "type": "number",
            "description": "金鑰有效時長，單位分鐘。預設 1440（24 小時），可指定 1～43200。",
            "default": 1440,
            "minimum": 1,
            "maximum": 43200
          },
          "vehicle_codes": {
            "description": "需取得 MQTT 用戶端憑證之車輛代號；未指定時回傳全部已簽發之車輛。",
            "example": [
              "PMS-01",
              "PMS-02"
            ],
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "username",
          "password"
        ]
      },
      "IssuedTokenDto": {
        "type": "object",
        "properties": {
          "api_key": {
            "type": "string",
            "description": "呼叫各介面時帶入 x-api-key 標頭之值"
          },
          "token_type": {
            "type": "string",
            "description": "固定為 ApiKey",
            "example": "ApiKey"
          },
          "issued_at": {
            "type": "number",
            "description": "簽發時間，Unix Epoch 毫秒",
            "example": 1787890000000
          },
          "expires_at": {
            "type": "number",
            "description": "失效時間，Unix Epoch 毫秒",
            "example": 1787976400000
          },
          "expires_in_minutes": {
            "type": "number",
            "description": "有效時長，分鐘",
            "example": 1440
          },
          "mqtt": {
            "description": "MQTT 連線資訊與用戶端憑證",
            "allOf": [
              {
                "$ref": "#/components/schemas/MqttBundleDto"
              }
            ]
          }
        },
        "required": [
          "api_key",
          "token_type",
          "issued_at",
          "expires_at",
          "expires_in_minutes",
          "mqtt"
        ]
      },
      "MqttBundleDto": {
        "type": "object",
        "properties": {
          "host": {
            "type": "string",
            "description": "MQTT broker 位址",
            "example": "34.80.84.224"
          },
          "port": {
            "type": "number",
            "description": "MQTT broker 埠",
            "example": 8883
          },
          "tls": {
            "type": "boolean",
            "description": "固定為 true，連線採 TLS 雙向驗證",
            "example": true
          },
          "ca_certificate": {
            "type": "string",
            "description": "CA 憑證，PEM 格式"
          },
          "clients": {
            "description": "各車之用戶端憑證與私鑰",
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/MqttClientCertificateDto"
            }
          }
        },
        "required": [
          "host",
          "port",
          "tls",
          "ca_certificate",
          "clients"
        ]
      },
      "MqttClientCertificateDto": {
        "type": "object",
        "properties": {
          "vehicle_code": {
            "type": "string",
            "description": "車輛代號",
            "example": "PMS-01"
          },
          "certificate": {
            "type": "string",
            "description": "該車用戶端憑證，PEM 格式"
          },
          "private_key": {
            "type": "string",
            "description": "該車用戶端私鑰，PEM 格式"
          }
        },
        "required": [
          "vehicle_code",
          "certificate",
          "private_key"
        ]
      },
      "StationEtaEntryDto": {
        "type": "object",
        "properties": {
          "vehicle_code": {
            "type": "string",
            "example": "PMS-05"
          },
          "order_id": {
            "type": "object",
            "nullable": true,
            "example": "260816-ST0007"
          },
          "trip_code": {
            "type": "object",
            "nullable": true,
            "example": "ST0007",
            "description": "路線代號＋發車時刻 HHMM"
          },
          "route_code": {
            "type": "object",
            "nullable": true,
            "example": "ST"
          },
          "route_name": {
            "type": "object",
            "nullable": true,
            "example": "S2W上行 > T3上行"
          },
          "vehicle_phase": {
            "type": "string",
            "nullable": true,
            "enum": [
              "TRANSITING",
              "FAULTED"
            ],
            "description": "車端營運階段，原值透傳；資料逾時或車端未提供時為 null"
          },
          "arrival_state": {
            "type": "string",
            "enum": [
              "EN_ROUTE",
              "APPROACHING",
              "DOCKING",
              "AT_STATION",
              "DEPARTED",
              "UNKNOWN"
            ],
            "description": "APPROACHING＝即將進站（eta ≤ 60 秒或距離 ≤ 200 公尺）；EN_ROUTE＝預計到達；UNKNOWN＝車端資料逾時或缺少目標站"
          },
          "eta_seconds": {
            "type": "object",
            "nullable": true,
            "example": 25,
            "description": "以 observed_at 為基準的剩餘秒數，非以收到回應的時刻為基準"
          },
          "eta_at": {
            "type": "object",
            "nullable": true,
            "example": 1786842023000,
            "description": "恆等於 observed_at + eta_seconds × 1000。倒數計時必須用這個欄位"
          },
          "eta_clock": {
            "type": "object",
            "nullable": true,
            "example": "09:00:23"
          },
          "distance_to_station_m": {
            "type": "object",
            "nullable": true,
            "example": 120,
            "description": "路徑距離，公尺"
          },
          "plan": {
            "$ref": "#/components/schemas/EtaPlanDto"
          },
          "observed_at": {
            "type": "number",
            "example": 1786841998000,
            "description": "車端回報時刻"
          },
          "observed_clock": {
            "type": "string",
            "example": "08:59:58"
          },
          "data_age_seconds": {
            "type": "number",
            "example": 2,
            "description": "generated_at 減 observed_at。失聯是以「資料變舊」呈現而非欄位消失，不可只用欄位是否存在判斷"
          }
        },
        "required": [
          "vehicle_code",
          "order_id",
          "trip_code",
          "route_code",
          "route_name",
          "vehicle_phase",
          "arrival_state",
          "eta_seconds",
          "eta_at",
          "eta_clock",
          "distance_to_station_m",
          "plan",
          "observed_at",
          "observed_clock",
          "data_age_seconds"
        ]
      },
